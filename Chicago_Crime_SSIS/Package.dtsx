      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{F2B84BCD-BD76-48DB-85B1-8A44A79D5FAA}"
          SQLTask:SqlStatementSource="-- 1. Bảng DIM_CRIME_TYPE&#xA;CREATE TABLE DIM_CRIME_TYPE&#xA;(&#xA;    IUCR_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    IUCR_CODE NVARCHAR(50) NOT NULL,&#xA;    PRIMARY_TYPE NVARCHAR(100) NOT NULL,&#xA;    DESCRIPTION NVARCHAR(255) NULL,&#xA;    FBI_CODE NVARCHAR(50) NULL&#xA;);&#xA;GO&#xA;&#xA;-- 2. Bảng DIM_POLICE_GEOGRAPHY&#xA;CREATE TABLE DIM_POLICE_GEOGRAPHY&#xA;(&#xA;    POLICE_GEO_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    BEAT INT,&#xA;    DISTRICT INT&#xA;);&#xA;GO&#xA;&#xA;-- 3. Bảng DIM_HOUR&#xA;CREATE TABLE DIM_HOUR&#xA;(&#xA;    HOUR_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    HOUR INT NOT NULL,&#xA;    TIME_PERIOD NVARCHAR(50) NULL&#xA;);&#xA;GO&#xA;&#xA;-- 4. Bảng DIM_LOCATION&#xA;CREATE TABLE DIM_LOCATION&#xA;(&#xA;    LOCATION_ID INT IDENTITY(1,1) PRIMARY KEY,&#xA;    BLOCK NVARCHAR(255),&#xA;    LOCATION_DESCRIPTION NVARCHAR(255),&#xA;    COMMUNITY_AREA INT,&#xA;    WARD INT&#xA;);&#xA;GO&#xA;&#xA;-- 5. Bảng DIM_DATE&#xA;CREATE TABLE DIM_DATE&#xA;(&#xA;    DATE_ID INT PRIMARY KEY,&#xA;    FULL_DATE DATE NOT NULL,&#xA;    YEAR INT,&#xA;    MONTH INT,&#xA;    DAY INT,&#xA;    DAY_OF_WEEK NVARCHAR(50),&#xA;    QUARTER INT,&#xA;    IS_WEEKEND BIT&#xA;);&#xA;GO&#xA;&#xA;-- 6. Bảng FACT_CRIMES&#xA;CREATE TABLE FACT_CRIMES&#xA;(&#xA;    CRIME_ID INT PRIMARY KEY,&#xA;    CASE_NUMBER NVARCHAR(50) NOT NULL,&#xA;    IUCR_ID INT NOT NULL,&#xA;    LOCATION_ID INT NOT NULL,&#xA;    POLICE_GEO_ID INT NOT NULL,&#xA;    DATE_ID INT NOT NULL,&#xA;    HOUR_ID INT NULL,&#xA;    IS_ARREST BIT,&#xA;    IS_DOMESTIC BIT,&#xA;    CRIME_COUNT INT,&#xA;&#xA;    CONSTRAINT FK_FACT_DIM_CRIME_TYPE&#xA;        FOREIGN KEY (IUCR_ID)&#xA;        REFERENCES DIM_CRIME_TYPE(IUCR_ID),&#xA;&#xA;    CONSTRAINT FK_FACT_DIM_LOCATION&#xA;        FOREIGN KEY (LOCATION_ID)&#xA;        REFERENCES DIM_LOCATION(LOCATION_ID),&#xA;&#xA;    CONSTRAINT FK_FACT_DIM_POLICE_GEOGRAPHY&#xA;        FOREIGN KEY (POLICE_GEO_ID)&#xA;        REFERENCES DIM_POLICE_GEOGRAPHY(POLICE_GEO_ID),&#xA;&#xA;    CONSTRAINT FK_FACT_DIM_DATE&#xA;        FOREIGN KEY (DATE_ID)&#xA;        REFERENCES DIM_DATE(DATE_ID),&#xA;&#xA;    CONSTRAINT FK_FACT_DIM_HOUR&#xA;        FOREIGN KEY (HOUR_ID)&#xA;        REFERENCES DIM_HOUR(HOUR_ID)&#xA;);&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
